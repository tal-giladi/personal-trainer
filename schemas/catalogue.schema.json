{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalogue.schema.json",
  "title": "Exercise catalogue",
  "type": "object",
  "required": ["exercises"],
  "properties": {
    "exercises": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "muscles", "equipment", "unit"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "muscles": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "equipment": { "type": "string", "enum": ["dumbbell", "band", "bodyweight", "pull_up_bar", "bench", "none"] },
          "unit": { "type": "string", "enum": ["reps", "time", "distance"] },
          "substitute": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
