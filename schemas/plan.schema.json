{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan.schema.json",
  "title": "Training plan (templates + rules)",
  "type": "object",
  "required": ["name", "starts", "weeks", "days", "selection"],
  "$defs": {
    "exerciseList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "sets": { "type": "integer", "minimum": 1 },
          "reps": { "type": "integer", "minimum": 1 },
          "kg": { "anyOf": [{ "type": "number", "minimum": 0 }, { "const": "TODO" }] },
          "sec": { "type": "integer", "minimum": 1 },
          "min": { "type": "number", "minimum": 0 },
          "km": { "type": "number", "minimum": 0 },
          "blocks": { "type": "integer", "minimum": 1 },
          "rounds": { "type": "integer", "minimum": 1 },
          "work_sec": { "type": "integer", "minimum": 1 },
          "rest_sec": { "type": "integer", "minimum": 0 },
          "rest_between_blocks_sec": { "type": "integer", "minimum": 0 },
          "moves": { "type": "array", "items": { "type": "string" } },
          "note": { "type": "string" }
        }
      }
    }
  },
  "properties": {
    "name": { "type": "string" },
    "starts": { "type": "string", "format": "date" },
    "weeks": { "type": "integer", "minimum": 1 },
    "deload_every_n_weeks": { "type": "integer", "minimum": 2 },
    "progression": { "type": "object" },
    "selection": {
      "type": "object",
      "required": ["recovery_hours", "weekly_targets"],
      "properties": {
        "recovery_hours": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "weekly_targets": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "stale_after_days": { "type": "integer", "minimum": 1 },
        "notes": { "type": "string" }
      }
    },
    "days": {
      "type": "object",
      "patternProperties": {
        "^[A-G]$": {
          "type": "object",
          "required": ["focus", "groups", "exercises"],
          "properties": {
            "focus": { "type": "string" },
            "groups": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "exercises": { "$ref": "#/$defs/exerciseList" }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
