{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan.schema.json",
  "title": "Training plan",
  "type": "object",
  "required": ["name", "starts", "weeks", "days", "schedule"],
  "properties": {
    "name": { "type": "string" },
    "starts": { "type": "string", "format": "date" },
    "weeks": { "type": "integer", "minimum": 1 },
    "deload_every_n_weeks": { "type": "integer", "minimum": 2 },
    "progression": { "type": "object" },
    "days": {
      "type": "object",
      "patternProperties": {
        "^[A-G]$": {
          "type": "object",
          "required": ["focus", "exercises"],
          "properties": {
            "focus": { "type": "string" },
            "exercises": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "sets": { "type": "integer", "minimum": 1 },
                  "reps": { "type": "integer", "minimum": 1 },
                  "kg": { "anyOf": [{ "type": "number", "minimum": 0 }, { "const": "TODO" }] },
                  "sec": { "type": "integer", "minimum": 1 },
                  "min": { "type": "number", "minimum": 0 },
                  "km": { "type": "number", "minimum": 0 },
                  "blocks": { "type": "integer", "minimum": 1 },
                  "rounds": { "type": "integer", "minimum": 1 },
                  "work_sec": { "type": "integer", "minimum": 1 },
                  "rest_sec": { "type": "integer", "minimum": 0 },
                  "rest_between_blocks_sec": { "type": "integer", "minimum": 0 },
                  "moves": { "type": "array", "items": { "type": "string" } },
                  "note": { "type": "string" }
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "schedule": {
      "type": "object",
      "required": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"],
      "additionalProperties": false,
      "properties": {
        "mon": { "type": "string" }, "tue": { "type": "string" }, "wed": { "type": "string" },
        "thu": { "type": "string" }, "fri": { "type": "string" }, "sat": { "type": "string" },
        "sun": { "type": "string" }
      }
    }
  }
}
