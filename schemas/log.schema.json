{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "log.schema.json",
  "title": "Session log",
  "type": "object",
  "required": ["date", "plan", "day", "exercises"],
  "additionalProperties": false,
  "properties": {
    "date": { "type": "string", "format": "date" },
    "plan": { "type": "string" },
    "day": { "type": "string", "pattern": "^[A-G]$|^free$" },
    "duration_min": { "type": "integer", "minimum": 1, "maximum": 300 },
    "rpe": { "type": "number", "minimum": 1, "maximum": 10 },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "sets"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "substituted_for": { "type": "string" },
          "sets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "reps": { "type": "integer", "minimum": 0 },
                "kg": { "type": "number", "minimum": 0 },
                "sec": { "type": "integer", "minimum": 0 },
                "min": { "type": "number", "minimum": 0 },
                "km": { "type": "number", "minimum": 0 },
                "rounds": { "type": "integer", "minimum": 1 },
                "work_sec": { "type": "integer", "minimum": 1 },
                "rest_sec": { "type": "integer", "minimum": 0 },
                "moves": { "type": "array", "items": { "type": "string" } },
                "rpe": { "type": "number", "minimum": 1, "maximum": 10 },
                "note": { "type": "string" }
              }
            }
          },
          "note": { "type": "string" }
        }
      }
    },
    "pain": { "type": "array", "items": { "type": "object", "required": ["area"], "properties": { "area": { "type": "string" }, "note": { "type": "string" } } } },
    "notes": { "type": "string" }
  }
}
