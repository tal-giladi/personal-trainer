{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "next.schema.json",
  "title": "Next planned session",
  "type": "object",
  "required": [
    "date",
    "type",
    "groups",
    "reason",
    "exercises"
  ],
  "additionalProperties": false,
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "type": {
      "type": "string",
      "enum": [
        "strength",
        "hiit",
        "cardio",
        "recovery"
      ]
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "legs",
          "push",
          "pull",
          "core",
          "cardio"
        ]
      },
      "minItems": 1
    },
    "template": {
      "type": "string",
      "pattern": "^[A-G]$"
    },
    "reason": {
      "type": "string",
      "maxLength": 200
    },
    "duration_min": {
      "type": "integer",
      "minimum": 5
    },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "sets": {
            "type": "integer",
            "minimum": 1
          },
          "reps": {
            "type": "integer",
            "minimum": 1
          },
          "kg": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "const": "TODO"
              }
            ]
          },
          "sec": {
            "type": "integer",
            "minimum": 1
          },
          "min": {
            "type": "number",
            "minimum": 0
          },
          "km": {
            "type": "number",
            "minimum": 0
          },
          "blocks": {
            "type": "integer",
            "minimum": 1
          },
          "rounds": {
            "type": "integer",
            "minimum": 1
          },
          "work_sec": {
            "type": "integer",
            "minimum": 1
          },
          "rest_sec": {
            "type": "integer",
            "minimum": 0
          },
          "rest_between_blocks_sec": {
            "type": "integer",
            "minimum": 0
          },
          "moves": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
